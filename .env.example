# Copia este fichero a .env y rellena la clave.
# .env esta ignorado por git: nunca se sube al repositorio.

# --- Obligatorio ---
LLMPULSE_API_KEY=pon_aqui_tu_clave

# --- Los escriben los scripts 02 y 03 al elegir ---
LLMPULSE_PROJECT_ID=
LLMPULSE_COLLECTION_ID=

# --- Ventana temporal de la muestra (AAAA-MM-DD) ---
LLMPULSE_FROM=
LLMPULSE_TO=

# --- Parametros del muestreo ---
# Numero de prompts distintos a muestrear.
#   4     -> prueba exploratoria (ver el esquema con pocas llamadas)
#   all   -> TODOS los prompts del tag, que es lo que necesita el NAR definitivo
LLMPULSE_NUM_PROMPTS=4
# Tope de seguridad de respuestas descargadas.
# Con NUM_PROMPTS=all hay que subirlo o cortara la descarga antes de tiempo.
LLMPULSE_MAX_ANSWERS=40
